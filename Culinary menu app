                <span class="bg-gold-500 text-maroon-950 font-black text-[10px] uppercase tracking-wider px-2.5 py-1 rounded-lg shadow-md flex items-center gap-1">
                  <i data-lucide="sparkles" class="w-3 h-3 fill-maroon-950"></i> Daily Special
                </span>
              ` : ''}
              
              ${!dish.isAvailable ? `
                <span class="bg-rose-800 text-white font-extrabold text-[10px] uppercase tracking-wider px-2.5 py-1 rounded-lg shadow-md">
                  Sold Out
                </span>
              ` : `
                <span class="bg-emerald-700 text-white font-bold text-[10px] uppercase tracking-wider px-2.5 py-1 rounded-lg shadow-md">
                  Available
                </span>
              `}
