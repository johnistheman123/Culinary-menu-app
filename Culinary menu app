    // SEARCH & FILTER HANDLERS
    function handleSearch(val) {
      state.searchQuery = val;
      document.getElementById('searchInput').value = val;
      const btn = document.getElementById('clearSearchBtn');
      if (val.length > 0) btn.classList.remove('hidden');
      else btn.classList.add('hidden');

      renderFullMenu();
    }

    function filterCategory(catId) {
      state.currentCategory = catId;
      renderCategories();
      renderFullMenu();
    }

    function setDietaryFilter(tag) {
      state.dietaryFilter = tag;
      document.querySelectorAll('.dietary-btn').forEach(b => {
        b.classList.remove('bg-maroon-800', 'border-maroon-800', 'text-white');
        b.classList.add('border-cream-300', 'bg-white', 'text-charcoal-800');
      });
      const activeBtn = document.getElementById(`tag-${tag}`);
      if (activeBtn) {
        activeBtn.classList.remove('border-cream-300', 'bg-white', 'text-charcoal-800');
        activeBtn.classList.add('bg-maroon-800', 'border-maroon-800', 'text-white');
      }
      renderFullMenu();
    }

    function toggleAvailableOnly(checked) {
      state.hideSoldOut = checked;
      renderFullMenu();
    }

    function resetFilters() {
      state.currentCategory = 'all';
      state.searchQuery = '';
      state.dietaryFilter = 'ALL';
      state.hideSoldOut = false;
      document.getElementById('availableOnlyToggle').checked = false;
      document.getElementById('searchInput').value = '';
      setDietaryFilter('ALL');
      renderCategories();
      renderFullMenu();
      showToast('Filters reset');
    }

    // LIKE DISH TOGGLE
    function toggleLikeDish(dishId) {
      const dish = state.dishes.find(d => d.id === dishId);
      if (!dish) return;

      if (state.userLikedDishes.has(dishId)) {
        state.userLikedDishes.delete(dishId);
        dish.likes = Math.max(0, (dish.likes || 1) - 1);
      } else {
        state.userLikedDishes.add(dishId);
        dish.likes = (dish.likes || 0) + 1;
        showToast(`❤️ Liked ${dish.title}!`);
      }

      localStorage.setItem(KEY_LIKES, JSON.stringify(Array.from(state.userLikedDishes)));
      saveDishesToStorage();
      renderAllViews();
    }

    // CART / PLATE TRAY MANAGEMENT
    function addToPlate(dishId) {
      const dish = state.dishes.find(d => d.id === dishId);
      if (!dish || !dish.isAvailable) return;

      const existing = state.cart.find(item => item.dishId === dishId);
      if (existing) existing.quantity += 1;
      else state.cart.push({ dishId, quantity: 1 });

      updateCartUI();
      renderAllViews();
      showToast(`Added ${dish.title} to Plate`);
    }

    function updateCartQuantity(dishId, delta) {
      const idx = state.cart.findIndex(item => item.dishId === dishId);
      if (idx === -1) return;

      state.cart[idx].quantity += delta;
      if (state.cart[idx].quantity <= 0) state.cart.splice(idx, 1);

      updateCartUI();
      renderAllViews();
    }

    function clearCart() {
      state.cart = [];
      updateCartUI();
      renderAllViews();
      showToast('Plate cleared');
    }

    function updateCartUI() {
      const totalCount = state.cart.reduce((s, i) => s + i.quantity, 0);
      document.getElementById('cartBadge').textContent = totalCount;

      const container = document.getElementById('cartItemsList');
      if (state.cart.length === 0) {
        container.innerHTML = `
          <div class="text-center py-12 text-charcoal-800/60">
            <i data-lucide="shopping-bag" class="w-12 h-12 mx-auto mb-3 opacity-30 text-maroon-800"></i>
            <p class="text-sm font-bold text-maroon-900">Your Plate is Empty</p>
            <p class="text-xs mt-1">Select creations from The Culinary Room to add here.</p>
          </div>
        `;
        document.getElementById('cartSubtotal').textContent = '$0.00';
        document.getElementById('cartTotal').textContent = '$0.00';
        lucide.createIcons();
        return;
      }

      let subtotal = 0;
      container.innerHTML = state.cart.map(item => {
        const dish = state.dishes.find(d => d.id === item.dishId);
        if (!dish) return '';
        const line = dish.price * item.quantity;
        subtotal += line;

        return `
          <div class="flex items-center gap-3 bg-cream-100 p-3 rounded-2xl border border-cream-300">
            <img src="${dish.image}" alt="${dish.title}" class="w-14 h-14 rounded-xl object-cover">
            <div class="flex-1 min-w-0">
              <h4 class="text-xs font-bold text-maroon-900 truncate">${dish.title}</h4>
              <p class="text-xs font-mono text-maroon-800 font-extrabold mt-0.5">$${dish.price.toFixed(2)}</p>
            </div>
            <div class="flex items-center gap-2 bg-white border border-cream-300 rounded-xl p-1 shadow-sm">
              <button onclick="updateCartQuantity('${dish.id}', -1)" class="w-6 h-6 rounded bg-cream-200 text-maroon-900 font-bold flex items-center justify-center text-xs hover:bg-cream-300">
                -
              </button>
              <span class="font-mono text-xs font-bold text-maroon-900 w-4 text-center">${item.quantity}</span>
              <button onclick="updateCartQuantity('${dish.id}', 1)" class="w-6 h-6 rounded bg-cream-200 text-maroon-900 font-bold flex items-center justify-center text-xs hover:bg-cream-300">
                +
              </button>
            </div>
          </div>
        `;
      }).join('');

      document.getElementById('cartSubtotal').textContent = `$${subtotal.toFixed(2)}`;
      document.getElementById('cartTotal').textContent = `$${subtotal.toFixed(2)}`;
      lucide.createIcons();
    }

    function toggleCartDrawer() {
      document.getElementById('cartDrawer').classList.toggle('hidden');
    }

    function submitSimulatedOrder() {
      if (state.cart.length === 0) {
        showToast('Plate is empty!');
        return;
      }
      const total = state.cart.reduce((s, i) => {
        const d = state.dishes.find(item => item.id === i.dishId);
        return s + (d ? d.price * i.quantity : 0);
      }, 0);

      showToast(`🎉 Plate order summary ready! Total: $${total.toFixed(2)}`);
      toggleCartDrawer();
      state.cart = [];
      updateCartUI();
      renderAllViews();
    }

    // ADMIN MODE TOGGLE
    function toggleAdminMode() {
      state.isAdmin = !state.isAdmin;
      const btn = document.getElementById('modeToggleBtn');
      const text = document.getElementById('modeText');
      const panel = document.getElementById('adminControlPanel');
      const editBanner = document.getElementById('editBannerBtn');

      if (state.isAdmin) {
        text.textContent = "Instructor View";
        btn.classList.remove('bg-cream-200', 'text-maroon-900');
        btn.classList.add('bg-maroon-800', 'text-white', 'font-bold');
        panel.classList.remove('hidden');
        editBanner.classList.remove('hidden');
        showToast('🔓 Switched to Instructor Admin Portal');
      } else {
        text.textContent = "Customer View";
        btn.classList.remove('bg-maroon-800', 'text-white', 'font-bold');
        btn.classList.add('bg-cream-200', 'text-maroon-900');
        panel.classList.add('hidden');
        editBanner.classList.add('hidden');
        showToast('🔒 Switched to Customer View');
      }

      renderAllViews();
    }

    function toggleDishDailyStatus(dishId) {
      const dish = state.dishes.find(d => d.id === dishId);
      if (!dish) return;
      dish.isDailyDish = !dish.isDailyDish;
      saveDishesToStorage();
      renderAllViews();
      showToast(`${dish.title} is ${dish.isDailyDish ? 'marked as Daily Special!' : 'removed from Daily Specials'}`);
    }

    function toggleDishStock(dishId) {
      const dish = state.dishes.find(d => d.id === dishId);
      if (!dish) return;
      dish.isAvailable = !dish.isAvailable;
      saveDishesToStorage();
      renderAllViews();
      showToast(`${dish.title} status changed to ${dish.isAvailable ? 'Available' : 'Sold Out'}`);
    }

    // DISH MODAL LOGIC
    function openAddDishModal() {
      document.getElementById('dishModalTitle').textContent = "Add New Junior Chef Creation";
      document.getElementById('dishFormId').value = "";
      document.getElementById('dishForm').reset();
      document.getElementById('dishFormAvailable').checked = true;
      document.getElementById('dishModal').classList.remove('hidden');
    }

    function openEditDishModal(dishId) {
      const dish = state.dishes.find(d => d.id === dishId);
      if (!dish) return;

      document.getElementById('dishModalTitle').textContent = "Edit Junior Chef Creation";
      document.getElementById('dishFormId').value = dish.id;
      document.getElementById('dishFormTitle').value = dish.title;
      document.getElementById('dishFormCategory').value = dish.category;
      document.getElementById('dishFormPrice').value = dish.price;
      document.getElementById('dishFormDesc').value = dish.description;
      document.getElementById('dishFormImage').value = dish.image;
      document.getElementById('dishFormChefNote').value = dish.chefNote || '';

      document.getElementById('tagVegetarian').checked = dish.dietary.includes('Vegetarian');
      document.getElementById('tagVegan').checked = dish.dietary.includes('Vegan');
      document.getElementById('tagGlutenFree').checked = dish.dietary.includes('Gluten-Free');
      document.getElementById('tagNutFree').checked = dish.dietary.includes('Nut-Free');

      document.getElementById('dishFormAvailable').checked = dish.isAvailable;
      document.getElementById('dishFormDaily').checked = !!dish.isDailyDish;

      document.getElementById('dishModal').classList.remove('hidden');
    }

    function closeDishModal() { document.getElementById('dishModal').classList.add('hidden'); }

    function setPresetImage(key) {
      if (PRESET_IMAGES[key]) {
        document.getElementById('dishFormImage').value = PRESET_IMAGES[key];
        showToast(`Selected ${key} image preset`);
      }
    }

    function handleDishSubmit(e) {
      e.preventDefault();

      const id = document.getElementById('dishFormId').value;
      const title = document.getElementById('dishFormTitle').value.trim();
      const category = document.getElementById('dishFormCategory').value;
      const price = parseFloat(document.getElementById('dishFormPrice').value);
      const description = document.getElementById('dishFormDesc').value.trim();
      let image = document.getElementById('dishFormImage').value.trim();
      const chefNote = document.getElementById('dishFormChefNote').value.trim();

      if (!image) image = PRESET_IMAGES[category] || PRESET_IMAGES.burger;

      const dietary = [];
      if (document.getElementById('tagVegetarian').checked) dietary.push('Vegetarian');
      if (document.getElementById('tagVegan').checked) dietary.push('Vegan');
      if (document.getElementById('tagGlutenFree').checked) dietary.push('Gluten-Free');
      if (document.getElementById('tagNutFree').checked) dietary.push('Nut-Free');

      const isAvailable = document.getElementById('dishFormAvailable').checked;
      const isDailyDish = document.getElementById('dishFormDaily').checked;

      if (id) {
        const idx = state.dishes.findIndex(d => d.id === id);
        if (idx !== -1) {
          state.dishes[idx] = { ...state.dishes[idx], title, category, price, description, image, chefNote, dietary, isAvailable, isDailyDish };
          showToast(`Updated ${title}`);
        }
      } else {
        const newDish = { id: 'dish-' + Date.now(), title, category, price, description, image, chefNote, dietary, isAvailable, isDailyDish, likes: 0 };
        state.dishes.unshift(newDish);
        showToast(`Added ${title}`);
      }

      saveDishesToStorage();
      closeDishModal();
      renderAllViews();
    }

    function confirmDeleteDish(dishId) {
      const dish = state.dishes.find(d => d.id === dishId);
      if (!dish) return;

      openConfirmModal(
        'Delete Dish',
        `Are you sure you want to delete "${dish.title}"?`,
        () => {
          state.dishes = state.dishes.filter(d => d.id !== dishId);
          state.cart = state.cart.filter(item => item.dishId !== dishId);
          saveDishesToStorage();
          updateCartUI();
          renderAllViews();
          showToast(`Deleted ${dish.title}`);
        }
      );
    }

    // INSTRUCTOR MODAL LOGIC
    function openAddInstructorModal() {
      document.getElementById('instructorModalTitle').textContent = "Add Chef Instructor";
      document.getElementById('instructorFormId').value = "";
      document.getElementById('instructorForm').reset();
      document.getElementById('instructorModal').classList.remove('hidden');
    }

    function openEditInstructorModal(instId) {
      const inst = state.instructors.find(i => i.id === instId);
      if (!inst) return;

      document.getElementById('instructorModalTitle').textContent = "Edit Chef Instructor Profile";
      document.getElementById('instructorFormId').value = inst.id;
      document.getElementById('instructorFormName').value = inst.name;
      document.getElementById('instructorFormTitle').value = inst.title;
      document.getElementById('instructorFormExp').value = inst.yearsExp;
      document.getElementById('instructorFormSpecialty').value = inst.specialty;
      document.getElementById('instructorFormImage').value = inst.image;
      document.getElementById('instructorFormBio').value = inst.bio;
      document.getElementById('instructorFormPhilosophy').value = inst.philosophy;

      document.getElementById('instructorModal').classList.remove('hidden');
    }

    function closeInstructorModal() { document.getElementById('instructorModal').classList.add('hidden'); }

    function handleInstructorSubmit(e) {
      e.preventDefault();

      const id = document.getElementById('instructorFormId').value;
      const name = document.getElementById('instructorFormName').value.trim();
      const title = document.getElementById('instructorFormTitle').value.trim();
      const yearsExp = parseInt(document.getElementById('instructorFormExp').value);
      const specialty = document.getElementById('instructorFormSpecialty').value.trim();
      let image = document.getElementById('instructorFormImage').value.trim();
      const bio = document.getElementById('instructorFormBio').value.trim();
      const philosophy = document.getElementById('instructorFormPhilosophy').value.trim();

      if (!image) image = "https://images.unsplash.com/photo-1577219491135-ce391730fb2c?auto=format&fit=crop&w=600&q=80";

      if (id) {
        const idx = state.instructors.findIndex(i => i.id === id);
        if (idx !== -1) {
          state.instructors[idx] = { id, name, title, yearsExp, specialty, image, bio, philosophy };
          showToast(`Updated ${name}`);
        }
      } else {
        const newInst = { id: 'inst-' + Date.now(), name, title, yearsExp, specialty, image, bio, philosophy };
        state.instructors.push(newInst);
        showToast(`Added instructor ${name}`);
      }

      saveInstructorsToStorage();
      closeInstructorModal();
      renderAllViews();
    }

    function confirmDeleteInstructor(instId) {
      const inst = state.instructors.find(i => i.id === instId);
      if (!inst) return;

      openConfirmModal(
        'Delete Instructor',
        `Are you sure you want to remove ${inst.name}?`,
        () => {
          state.instructors = state.instructors.filter(i => i.id !== instId);
          saveInstructorsToStorage();
          renderAllViews();
          showToast(`Removed instructor profile`);
        }
      );
    }

    // ANNOUNCEMENT MODAL LOGIC
    function toggleAnnouncementModal() {
      const modal = document.getElementById('announcementModal');
      document.getElementById('announcementInput').value = state.announcement;
      modal.classList.toggle('hidden');
    }

    function saveAnnouncement() {
      const val = document.getElementById('announcementInput').value.trim();
      if (val) {
        state.announcement = val;
        localStorage.setItem(KEY_ANNOUNCEMENT, val);
        document.getElementById('bannerText').textContent = val;
        showToast('Updated Daily Announcement');
      }
      toggleAnnouncementModal();
    }

    // RESET ALL DATA TO DEFAULT
    function confirmResetAll() {
      openConfirmModal(
        'Reset All School Data',
        'This will reset dishes, instructors, and Junior Chef count back to original defaults. Continue?',
        () => {
          state.dishes = [...DEFAULT_DISHES];
          state.instructors = [...DEFAULT_INSTRUCTORS];
          state.juniorChefCount = DEFAULT_JUNIOR_CHEFS;
          saveDishesToStorage();
          saveInstructorsToStorage();
          localStorage.setItem(KEY_CHEFS_COUNT, DEFAULT_JUNIOR_CHEFS);
          document.getElementById('adminChefCountInput').value = DEFAULT_JUNIOR_CHEFS;
          updateJuniorChefCountDisplays();
          renderAllViews();
          showToast('Data reset to defaults!');
        }
      );
    }

    // CUSTOM CONFIRMATION MODAL
    function openConfirmModal(title, message, onConfirm) {
      document.getElementById('confirmTitle').textContent = title;
      document.getElementById('confirmMessage').textContent = message;
      const modal = document.getElementById('confirmModal');
      
      const okBtn = document.getElementById('confirmOkBtn');
      const cancelBtn = document.getElementById('confirmCancelBtn');

      const cleanup = () => { modal.classList.add('hidden'); };

      okBtn.onclick = () => { onConfirm(); cleanup(); };
      cancelBtn.onclick = cleanup;

      modal.classList.remove('hidden');
    }

    // TOAST NOTIFICATIONS
    function showToast(msg) {
      const container = document.getElementById('toastContainer');
      const toast = document.createElement('div');
      toast.className = `pointer-events-auto flex items-center gap-2 px-4 py-3 rounded-2xl bg-maroon-900 text-white text-xs font-bold shadow-2xl border border-gold-500/30 transition-all duration-300 translate-y-4 opacity-0`;
      toast.innerHTML = `
        <i data-lucide="sparkles" class="w-4 h-4 text-gold-400 shrink-0"></i>
        <span>${msg}</span>
      `;
      container.appendChild(toast);
      lucide.createIcons();

      requestAnimationFrame(() => { toast.classList.remove('translate-y-4', 'opacity-0'); });

      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => toast.remove(), 300);
      }, 3000);
    }
  </script>
</body>
</html>
