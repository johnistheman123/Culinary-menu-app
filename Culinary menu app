            <button 
              onclick="toggleLikeDish('${dish.id}')" 
              class="absolute top-3 right-3 w-8 h-8 rounded-full bg-white/90 hover:bg-white text-maroon-800 backdrop-blur-md flex items-center justify-center shadow-md transition-all active:scale-90"
