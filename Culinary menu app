<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WACTC Culinary Class | The Culinary Room Menu</title>
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            maroon: {
              50: '#fdf2f4',
              100: '#fbe5e9',
              200: '#f7cfd6',
              300: '#f1abb8',
              400: '#e77a91',
              500: '#d74868',
              600: '#be2b4d',
              700: '#8b0000',
              800: '#6b0d1e', /* Signature WACTC Deep Maroon */
              900: '#4a0814',
              950: '#2d040b',
            },
            cream: {
              50: '#ffffff',
              100: '#fdfbf7', /* Soft Warm Cream Background */
              200: '#f7f2e9',
              300: '#ede4d3',
              400: '#dfd2b9',
            },
            gold: {
              300: '#fef08a',
              400: '#facc15',
              500: '#d4af37', /* Warm Gold Accent */
              600: '#ca8a04',
              700: '#a16207',
            },
            charcoal: {
              800: '#383434',
              900: '#2c2a2a', /* High-contrast rich text */
            }
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
            serif: ['Playfair Display', 'Georgia', 'serif'],
          }
        }
      }
    }
  </script>
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600&display=swap" rel="stylesheet">

  <style>
    body {
      font-family: 'Inter', sans-serif;
      background-color: #fdfbf7;
      color: #2c2a2a;
      overflow-x: hidden;
    }

    .font-serif-title {
      font-family: 'Playfair Display', Georgia, serif;
    }

    /* Modern Soft Card Styles */
    .card-shadow {
      box-shadow: 0 4px 20px -2px rgba(107, 13, 30, 0.06), 0 2px 6px -1px rgba(0, 0, 0, 0.04);
    }

    .card-shadow-hover:hover {
      box-shadow: 0 12px 28px -4px rgba(107, 13, 30, 0.12), 0 4px 10px -2px rgba(0, 0, 0, 0.06);
      transform: translateY(-2px);
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #f7f2e9;
    }
    ::-webkit-scrollbar-thumb {
      background: #6b0d1e;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #8b0000;
    }

    .transition-all-300 {
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
  </style>
</head>
<body class="min-h-full flex flex-col bg-cream-100 text-charcoal-900 antialiased selection:bg-maroon-800 selection:text-white">

  <!-- TOP DAILY ANNOUNCEMENT BANNER -->
  <div id="chefAnnouncementBanner" class="bg-gradient-to-r from-maroon-900 via-maroon-800 to-maroon-900 text-white text-xs sm:text-sm py-2 px-4 shadow-md relative z-40 flex items-center justify-between border-b border-gold-500/30">
    <div class="max-w-7xl mx-auto flex items-center justify-center gap-2 text-center w-full">
      <i data-lucide="sparkles" class="w-4 h-4 text-gold-400 shrink-0 animate-pulse"></i>
      <span id="bannerText" class="font-medium tracking-wide">
        Welcome to WACTC Culinary Class in The Culinary Room!
      </span>
      <span class="hidden md:inline-flex items-center gap-1 px-2.5 py-0.5 text-[11px] bg-white/10 rounded-full font-mono text-gold-300 ml-2 border border-white/20">
        <i data-lucide="door-open" class="w-3 h-3 text-gold-400"></i> The Culinary Room
      </span>
    </div>
    <button onclick="toggleAnnouncementModal()" id="editBannerBtn" class="hidden text-gold-400 hover:text-white text-xs underline shrink-0 ml-2 font-semibold">
      Edit Note
    </button>
  </div>

  <!-- MAIN BRAND HEADER -->
  <header class="sticky top-0 z-30 bg-white/95 backdrop-blur-md border-b border-cream-300 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-20">
        
        <!-- School Logo & Title -->
        <div class="flex items-center gap-3.5 cursor-pointer" onclick="switchTab('menu')">
          <div class="w-12 h-12 rounded-2xl bg-maroon-800 flex items-center justify-center shadow-md ring-2 ring-gold-500/50 text-gold-400">
            <i data-lucide="chef-hat" class="w-6 h-6"></i>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h1 class="text-xl sm:text-2xl font-extrabold font-serif-title tracking-tight text-maroon-900">
                WACTC <span class="text-maroon-700 font-normal">Culinary Class</span>
              </h1>
            </div>
            <p class="text-xs text-charcoal-800/80 font-semibold flex items-center gap-1">
              <i data-lucide="map-pin" class="w-3 h-3 text-maroon-800"></i> The Culinary Room
            </p>
          </div>
        </div>

        <!-- Navigation Tabs -->
        <nav class="hidden md:flex items-center gap-1 bg-cream-200 p-1.5 rounded-2xl border border-cream-300">
          <button 
            onclick="switchTab('menu')" 
            id="nav-tab-menu"
            class="px-4 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 bg-maroon-800 text-white shadow-sm"
          >
            <i data-lucide="book-open" class="w-4 h-4 text-gold-400"></i> Menu & Specials
          </button>
          <button 
            onclick="switchTab('instructors')" 
            id="nav-tab-instructors"
            class="px-4 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 text-charcoal-900 hover:bg-white hover:text-maroon-900"
          >
            <i data-lucide="award" class="w-4 h-4 text-maroon-800"></i> Meet Our Instructors
          </button>
        </nav>

        <!-- Right Side Header Action Buttons -->
        <div class="flex items-center gap-2.5">
          
          <!-- Admin Mode Toggle -->
          <button 
            id="modeToggleBtn" 
            onclick="toggleAdminMode()" 
            class="flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-bold bg-cream-200 hover:bg-cream-300 text-maroon-900 border border-maroon-800/20 transition-all"
            title="Toggle Admin Mode for Instructors"
          >
            <i data-lucide="shield" class="w-4 h-4 text-maroon-800" id="modeIcon"></i>
            <span id="modeText" class="hidden sm:inline">Customer View</span>
          </button>

          <!-- Order Plate Drawer Trigger -->
          <button 
            onclick="toggleCartDrawer()" 
            class="relative flex items-center gap-2 px-4 py-2 rounded-xl bg-maroon-800 hover:bg-maroon-700 text-white font-bold text-xs shadow-md transition-all active:scale-95"
          >
            <i data-lucide="shopping-bag" class="w-4 h-4 text-gold-400"></i>
            <span class="hidden sm:inline">My Plate</span>
            <span id="cartBadge" class="bg-gold-500 text-maroon-950 font-black text-[11px] w-5 h-5 rounded-full flex items-center justify-center">
              0
            </span>
          </button>

        </div>

      </div>

      <!-- Mobile Navigation Bar -->
      <div class="md:hidden flex items-center justify-around py-2.5 border-t border-cream-300 text-xs">
        <button onclick="switchTab('menu')" id="mob-tab-menu" class="flex flex-col items-center gap-1 text-maroon-800 font-bold py-1">
          <i data-lucide="book-open" class="w-4 h-4"></i> Menu & Specials
        </button>
        <button onclick="switchTab('instructors')" id="mob-tab-instructors" class="flex flex-col items-center gap-1 text-charcoal-800 font-semibold py-1">
          <i data-lucide="award" class="w-4 h-4"></i> Instructors
        </button>
      </div>

    </div>
  </header>

  <!-- HERO SECTION WITH MAROON ACCENT & STATS -->
  <section class="bg-gradient-to-br from-maroon-900 via-maroon-800 to-maroon-950 text-white py-10 px-4 sm:px-6 lg:px-8 relative overflow-hidden shadow-md">
    <!-- Subtle background accent glow -->
    <div class="absolute -top-24 -right-20 w-96 h-96 bg-gold-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-8 relative z-10">
      
      <div class="max-w-2xl text-center md:text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 border border-white/20 text-gold-300 text-xs font-semibold mb-3">
          <i data-lucide="utensils" class="w-3.5 h-3.5 text-gold-400"></i> The Culinary Room • Bistro Experience
        </div>
        
        <h2 class="text-3xl sm:text-5xl font-extrabold font-serif-title tracking-tight leading-tight">
          Crafted Fresh Daily by Our <span class="text-gold-400">Junior Chefs</span>.
        </h2>
        
        <p class="mt-3 text-cream-200 text-sm sm:text-base leading-relaxed">
          Welcome to <span class="text-white font-bold">WACTC Culinary Class</span> in <span class="text-gold-400 font-semibold">The Culinary Room</span>. Every dish is cooked fresh from scratch by aspiring Junior Chefs learning culinary fundamentals, kitchen precision, and global flavors.
        </p>

        <!-- Live Statistics Bar -->
        <div class="mt-6 flex flex-wrap items-center justify-center md:justify-start gap-4 text-xs font-semibold">
          
          <div class="flex items-center gap-2 bg-white/10 border border-white/15 px-3.5 py-2 rounded-xl backdrop-blur-sm">
            <i data-lucide="users" class="w-4 h-4 text-gold-400"></i>
            <span>Active Trainees: <strong id="statJuniorChefsCount" class="text-white font-mono text-sm font-bold">24 Junior Chefs</strong></span>
          </div>

          <div class="flex items-center gap-2 bg-white/10 border border-white/15 px-3.5 py-2 rounded-xl backdrop-blur-sm">
            <i data-lucide="clock" class="w-4 h-4 text-gold-400"></i>
            <span>Service Hours: <strong class="text-white">10:30 AM - 1:15 PM</strong></span>
          </div>

        </div>
      </div>

      <!-- Quick Special Highlight Card -->
      <div class="w-full md:w-auto shrink-0">
        <div class="bg-white text-charcoal-900 rounded-2xl p-5 border-2 border-gold-500 max-w-sm mx-auto shadow-xl relative overflow-hidden group">
          <div class="absolute -top-3 -right-3 bg-gold-500 text-maroon-950 font-black text-[10px] uppercase tracking-wider px-3 py-1.5 rounded-full shadow-md flex items-center gap-1">
            <i data-lucide="sparkles" class="w-3 h-3 fill-maroon-950"></i> Featured Daily Special
          </div>
          <div class="flex items-center gap-4">
            <img id="heroFeaturedImg" src="https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=300&q=80" alt="Special Dish" class="w-20 h-20 rounded-xl object-cover shadow-md group-hover:scale-105 transition-transform duration-300">
            <div>
              <span class="text-xs font-bold text-maroon-800 uppercase tracking-wider">Chef's Selection</span>
              <h3 id="heroFeaturedTitle" class="text-base font-bold text-charcoal-900 leading-snug">Seared Garlic Salmon</h3>
              <p id="heroFeaturedPrice" class="text-maroon-800 font-extrabold font-mono text-sm mt-0.5">$11.50</p>
              <button onclick="filterDailySpecialsOnly()" class="mt-2 inline-flex items-center gap-1 text-xs text-maroon-800 hover:text-maroon-600 font-bold">
                View All Specials <i data-lucide="arrow-right" class="w-3 h-3"></i>
              </button>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- MAIN APP CONTAINER -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <!-- ADMIN MANAGEMENT PANEL (VISIBLE WHEN ADMIN IS ON) -->
    <div id="adminControlPanel" class="hidden mb-8 p-6 rounded-2xl bg-white border-2 border-maroon-800 shadow-xl">
      <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
        <div>
          <div class="flex items-center gap-2">
            <span class="flex h-3 w-3 relative">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-maroon-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-3 w-3 bg-maroon-800"></span>
            </span>
            <h3 class="text-base font-extrabold text-maroon-900 uppercase tracking-wider flex items-center gap-2">
              <i data-lucide="shield-check" class="w-5 h-5 text-maroon-800"></i> Instructor Admin Portal
            </h3>
          </div>
          <p class="text-xs text-charcoal-800/80 mt-1 font-medium">Manage Junior Chefs counter, add/edit menu creations, toggle daily specials, or update instructor profiles.</p>
        </div>

        <!-- Admin Quick Tools -->
        <div class="flex flex-wrap items-center gap-3 w-full lg:w-auto">
          
          <!-- Live Junior Chef Counter Editor -->
          <div class="flex items-center gap-2 bg-cream-200 border border-maroon-800/20 px-3.5 py-1.5 rounded-xl">
            <i data-lucide="users" class="w-4 h-4 text-maroon-800 shrink-0"></i>
            <span class="text-xs text-charcoal-900 font-bold">Junior Chefs:</span>
            <input 
              type="number" 
              id="adminChefCountInput" 
              min="1" 
              max="100" 
              class="w-14 bg-white border border-maroon-800/30 rounded-lg px-2 py-1 text-xs text-center text-maroon-900 font-bold font-mono focus:outline-none focus:border-maroon-800"
              onchange="updateJuniorChefCount(this.value)"
            >
          </div>

          <button 
            onclick="openAddDishModal()" 
            class="flex items-center gap-2 bg-maroon-800 hover:bg-maroon-700 text-white font-bold px-4 py-2 rounded-xl text-xs shadow-md transition-all"
          >
            <i data-lucide="plus-circle" class="w-4 h-4 text-gold-400"></i> Add New Dish
          </button>

          <button 
            onclick="openAddInstructorModal()" 
            class="flex items-center gap-2 bg-cream-200 hover:bg-cream-300 text-maroon-900 font-bold border border-maroon-800/30 px-3.5 py-2 rounded-xl text-xs transition-all"
          >
            <i data-lucide="user-plus" class="w-4 h-4 text-maroon-800"></i> Add Instructor
          </button>

          <button 
            onclick="toggleAnnouncementModal()" 
            class="flex items-center gap-2 bg-cream-200 hover:bg-cream-300 text-maroon-900 font-bold border border-maroon-800/30 px-3.5 py-2 rounded-xl text-xs transition-all"
          >
            <i data-lucide="megaphone" class="w-4 h-4 text-maroon-800"></i> Edit Note
          </button>

          <button 
            onclick="confirmResetAll()" 
            class="flex items-center gap-2 bg-cream-200 hover:bg-rose-100 text-rose-800 border border-rose-300 font-bold px-3 py-2 rounded-xl text-xs transition-all"
            title="Reset to default menu and instructors"
          >
            <i data-lucide="rotate-ccw" class="w-4 h-4"></i> Reset All
          </button>

        </div>
      </div>
    </div>


    <!-- VIEW TAB 1: MENU & DAILY SPECIALS -->
    <div id="view-menu" class="space-y-8">
      
      <!-- DAILY DISHES & FEATURED SPECIALS HIGHLIGHT SPOTLIGHT -->
      <section id="dailyDishesSpotlight" class="bg-white rounded-3xl p-6 border-2 border-gold-500/60 card-shadow">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-cream-300">
          <div>
            <span class="px-3 py-1 rounded-full bg-gold-500/20 text-maroon-900 border border-gold-500/40 text-xs font-black uppercase tracking-wider inline-flex items-center gap-1.5 mb-1.5">
              <i data-lucide="sparkles" class="w-3.5 h-3.5 text-gold-600 fill-gold-600"></i> Today's Selected Highlights
            </span>
            <h2 class="text-2xl font-extrabold font-serif-title text-maroon-900">Daily Dishes & Chef Specials</h2>
            <p class="text-xs sm:text-sm text-charcoal-800/80">Fresh creations prepared specially for today's dining service by our Junior Chefs.</p>
          </div>
          <button onclick="filterDailySpecialsOnly()" class="text-xs font-bold text-maroon-800 hover:text-maroon-600 flex items-center gap-1 bg-cream-200 px-3 py-1.5 rounded-xl border border-maroon-800/20">
            Filter Specials Only <i data-lucide="chevron-right" class="w-4 h-4"></i>
          </button>
        </div>

        <!-- Daily Specials Horizontal Grid -->
        <div id="dailyDishesHighlightGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- JS Dynamic Daily Dishes Cards -->
        </div>
      </section>

      <!-- FULL MENU SEARCH & FILTERS TOOLBAR -->
      <div class="space-y-4">
        
        <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">
          
          <!-- Category Pills -->
          <div class="flex items-center gap-2 overflow-x-auto pb-1 scrollbar-none" id="categoryContainer">
            <!-- Rendered via JS -->
          </div>

          <!-- Live Search Box -->
          <div class="relative w-full md:w-72">
            <i data-lucide="search" class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-charcoal-800/50"></i>
            <input 
              type="text" 
              id="searchInput" 
              placeholder="Search dishes or ingredients..."
              class="w-full bg-white border border-cream-300 rounded-xl pl-10 pr-8 py-2 text-xs sm:text-sm text-charcoal-900 placeholder-charcoal-800/40 focus:outline-none focus:border-maroon-800 shadow-sm"
              oninput="handleSearch(this.value)"
            >
            <button id="clearSearchBtn" onclick="handleSearch('')" class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-charcoal-800/50 hover:text-maroon-900">
              <i data-lucide="x" class="w-4 h-4"></i>
            </button>
          </div>

        </div>

        <!-- Secondary Toolbar: Dietary Badges & Availability Toggle -->
        <div class="flex flex-wrap items-center justify-between gap-3 text-xs border-t border-cream-300 pt-3">
          
          <div class="flex items-center gap-2 overflow-x-auto py-0.5">
            <span class="text-charcoal-800/70 font-bold flex items-center gap-1 shrink-0">
              <i data-lucide="filter" class="w-3.5 h-3.5 text-maroon-800"></i> Dietary:
            </span>
            <button onclick="setDietaryFilter('ALL')" id="tag-ALL" class="dietary-btn px-3 py-1 rounded-lg border font-bold bg-maroon-800 border-maroon-800 text-white">
              All
            </button>
            <button onclick="setDietaryFilter('Vegetarian')" id="tag-Vegetarian" class="dietary-btn px-3 py-1 rounded-lg border border-cream-300 bg-white text-charcoal-800 font-semibold hover:border-maroon-800">
              🌱 Vegetarian
            </button>
            <button onclick="setDietaryFilter('Vegan')" id="tag-Vegan" class="dietary-btn px-3 py-1 rounded-lg border border-cream-300 bg-white text-charcoal-800 font-semibold hover:border-maroon-800">
              🌿 Vegan
            </button>
            <button onclick="setDietaryFilter('Gluten-Free')" id="tag-Gluten-Free" class="dietary-btn px-3 py-1 rounded-lg border border-cream-300 bg-white text-charcoal-800 font-semibold hover:border-maroon-800">
              🌾 Gluten-Free
            </button>
            <button onclick="setDietaryFilter('Nut-Free')" id="tag-Nut-Free" class="dietary-btn px-3 py-1 rounded-lg border border-cream-300 bg-white text-charcoal-800 font-semibold hover:border-maroon-800">
              🥜 Nut-Free
            </button>
          </div>

          <div class="flex items-center gap-3 shrink-0">
            <label class="flex items-center gap-2 cursor-pointer text-charcoal-800 font-medium hover:text-maroon-900">
              <input type="checkbox" id="availableOnlyToggle" onchange="toggleAvailableOnly(this.checked)" class="rounded bg-white border-cream-300 text-maroon-800 focus:ring-maroon-800">
              <span>Hide Sold Out</span>
            </label>
            <span id="resultsCount" class="text-maroon-900 bg-cream-200 px-2.5 py-1 rounded-md border border-cream-300 font-mono text-[11px] font-bold">
              0 items
            </span>
          </div>

        </div>

      </div>

      <!-- MAIN DISH CARDS GRID -->
      <div id="dishesGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Rendered via JS -->
      </div>

    </div>


    <!-- VIEW TAB 2: MEET OUR INSTRUCTORS PAGE -->
    <div id="view-instructors" class="hidden space-y-8">
      
      <div class="bg-white rounded-3xl p-8 border border-cream-300 text-center max-w-3xl mx-auto card-shadow">
        <div class="w-16 h-16 rounded-2xl bg-maroon-800 text-gold-400 flex items-center justify-center mx-auto mb-4 shadow-lg ring-4 ring-cream-200">
          <i data-lucide="award" class="w-8 h-8"></i>
        </div>
        <h2 class="text-3xl font-extrabold font-serif-title text-maroon-900">Meet Our Chef Instructors</h2>
        <p class="text-charcoal-800/80 text-sm mt-2 leading-relaxed font-medium">
          The culinary mentors guiding the next generation of chefs in <span class="text-maroon-800 font-bold">The Culinary Room</span>. Our instructors bring real-world industry experience, classical mastery, and a passion for teaching to WACTC.
        </p>
      </div>

      <!-- Instructors Cards Grid -->
      <div id="instructorsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- JS rendered instructor profiles -->
      </div>

    </div>


    <!-- EMPTY STATE WHEN NO MATCHES -->
    <div id="emptyState" class="hidden text-center py-16 px-4 bg-white rounded-3xl border border-cream-300 my-8 card-shadow">
      <div class="w-16 h-16 bg-cream-200 text-maroon-800 rounded-full flex items-center justify-center mx-auto mb-4 border border-cream-300">
        <i data-lucide="utensils-crossed" class="w-8 h-8"></i>
      </div>
      <h3 class="text-xl font-bold text-maroon-900 mb-1">No Culinary Creations Found</h3>
      <p class="text-charcoal-800/70 text-sm max-w-md mx-auto mb-6">We couldn't find any dishes matching your current filter or search term in The Culinary Room today.</p>
      <button onclick="resetFilters()" class="px-5 py-2.5 bg-maroon-800 hover:bg-maroon-700 text-white font-bold rounded-xl text-xs shadow-md transition-all">
        Reset All Filters
      </button>
    </div>

  </main>

  <!-- FOOTER -->
  <footer class="bg-maroon-900 text-white mt-16 py-12 text-xs border-t-4 border-gold-500">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
        <div>
          <div class="flex items-center gap-2 mb-3">
            <div class="w-8 h-8 rounded-lg bg-gold-500 flex items-center justify-center text-maroon-950 font-bold">
              <i data-lucide="chef-hat" class="w-5 h-5"></i>
            </div>
            <span class="text-white font-bold text-base font-serif-title">WACTC Culinary Class</span>
          </div>
          <p class="text-cream-200 leading-relaxed">
