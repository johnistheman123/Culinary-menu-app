    function switchTab(tabName) {
      state.activeTab = tabName;

      document.getElementById('view-menu').classList.add('hidden');
      document.getElementById('view-instructors').classList.add('hidden');

      document.getElementById(`view-${tabName}`).classList.remove('hidden');

      // Update Nav Buttons Styling
      ['menu', 'instructors'].forEach(t => {
        const desktopBtn = document.getElementById(`nav-tab-${t}`);
        const mobileBtn = document.getElementById(`mob-tab-${t}`);

        if (t === tabName) {
          if (desktopBtn) {
            desktopBtn.classList.add('bg-maroon-800', 'text-white', 'shadow-sm');
            desktopBtn.classList.remove('text-charcoal-900');
          }
          if (mobileBtn) {
            mobileBtn.classList.add('text-maroon-800', 'font-bold');
            mobileBtn.classList.remove('text-charcoal-800');
          }
        } else {
          if (desktopBtn) {
            desktopBtn.classList.remove('bg-maroon-800', 'text-white', 'shadow-sm');
            desktopBtn.classList.add('text-charcoal-900');
          }
          if (mobileBtn) {
            mobileBtn.classList.remove('text-maroon-800', 'font-bold');
            mobileBtn.classList.add('text-charcoal-800');
          }
        }
      });

      renderAllViews();
    }

