    // DISH CARD HTML GENERATOR
    function createDishCardHTML(dish, isDailyHighlight = false) {
      const isLiked = state.userLikedDishes.has(dish.id);
      const cartItem = state.cart.find(item => item.dishId === dish.id);
      const inCartQty = cartItem ? cartItem.quantity : 0;

      const tagPills = dish.dietary.map(t => {
        let c = "bg-cream-200 text-charcoal-900 border-cream-300";
        if (t === 'Vegetarian' || t === 'Vegan') c = "bg-emerald-50 text-emerald-800 border-emerald-200";
        if (t === 'Gluten-Free') c = "bg-amber-50 text-amber-900 border-amber-200";
        if (t === 'Nut-Free') c = "bg-blue-50 text-blue-900 border-blue-200";
        return `<span class="text-[10px] font-extrabold px-2 py-0.5 rounded-md border ${c}">${t}</span>`;
      }).join(' ');

      return `
        <div class="bg-white rounded-3xl overflow-hidden flex flex-col border border-cream-300 card-shadow card-shadow-hover transition-all duration-300 group ${!dish.isAvailable ? 'opacity-75 grayscale-[0.3]' : ''}">
          
          <div class="relative h-48 w-full overflow-hidden bg-cream-200">
            <img 
              src="${dish.image}" 
              alt="${dish.title}" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              onerror="this.src='https://placehold.co/600x400/6b0d1e/ffffff?text=The+Culinary+Room'"
