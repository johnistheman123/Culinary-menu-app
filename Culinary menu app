    function loadState() {
      // Dishes
      const savedDishes = localStorage.getItem(KEY_DISHES);
      if (savedDishes) {
        try { state.dishes = JSON.parse(savedDishes); } catch (e) { state.dishes = [...DEFAULT_DISHES]; }
      } else {
        state.dishes = [...DEFAULT_DISHES];
        saveDishesToStorage();
      }

      // Instructors
      const savedInstructors = localStorage.getItem(KEY_INSTRUCTORS);
      if (savedInstructors) {
        try { state.instructors = JSON.parse(savedInstructors); } catch (e) { state.instructors = [...DEFAULT_INSTRUCTORS]; }
      } else {
        state.instructors = [...DEFAULT_INSTRUCTORS];
        saveInstructorsToStorage();
      }

      // Junior Chef Count
      const savedChefCount = localStorage.getItem(KEY_CHEFS_COUNT);
      state.juniorChefCount = savedChefCount ? parseInt(savedChefCount) : DEFAULT_JUNIOR_CHEFS;
      document.getElementById('adminChefCountInput').value = state.juniorChefCount;

      // Announcement Banner
      const savedAnnounce = localStorage.getItem(KEY_ANNOUNCEMENT);
      if (savedAnnounce) state.announcement = savedAnnounce;
      document.getElementById('bannerText').textContent = state.announcement;

      // Likes
      const savedLikes = localStorage.getItem(KEY_LIKES);
      if (savedLikes) {
        try { state.userLikedDishes = new Set(JSON.parse(savedLikes)); } catch (e) {}
      }

      updateJuniorChefCountDisplays();
    }

    function saveDishesToStorage() { localStorage.setItem(KEY_DISHES, JSON.stringify(state.dishes)); }
