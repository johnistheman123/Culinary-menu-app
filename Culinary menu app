      }

      highlightGrid.innerHTML = dailyDishes.slice(0, 3).map(dish => createDishCardHTML(dish, true)).join('');
    }

    // TAB 1: RENDER FULL MENU
    function renderFullMenu() {
      const grid = document.getElementById('dishesGrid');
      const emptyState = document.getElementById('emptyState');

      let filtered = state.dishes.filter(dish => {
        if (state.currentCategory === 'daily-specials' && !dish.isDailyDish) return false;
        if (state.currentCategory !== 'all' && state.currentCategory !== 'daily-specials' && dish.category !== state.currentCategory) return false;

        if (state.searchQuery.trim() !== '') {
          const q = state.searchQuery.toLowerCase();
          const m1 = dish.title.toLowerCase().includes(q);
          const m2 = dish.description.toLowerCase().includes(q);
          const m3 = dish.dietary.some(t => t.toLowerCase().includes(q));
          if (!m1 && !m2 && !m3) return false;
        }

        if (state.dietaryFilter !== 'ALL' && !dish.dietary.includes(state.dietaryFilter)) return false;
        if (state.hideSoldOut && !dish.isAvailable) return false;

        return true;
      });

      document.getElementById('resultsCount').textContent = `${filtered.length} items`;

      if (filtered.length === 0) {
        grid.innerHTML = '';
        emptyState.classList.remove('hidden');
        return;
      } else {
        emptyState.classList.add('hidden');
      }

      grid.innerHTML = filtered.map(dish => createDishCardHTML(dish)).join('');
    }

